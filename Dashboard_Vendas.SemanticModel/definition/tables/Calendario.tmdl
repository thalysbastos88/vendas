table Calendario
	lineageTag: 467c9548-afe0-4276-86e8-03c022976f08

	column Date
		dataType: dateTime
		isKey
		formatString: Short Date
		lineageTag: 1e38ccc6-73a3-4ff3-8512-d618fca3f3ac
		summarizeBy: none
		sourceColumn: Date

		variation Variation
			isDefault
			relationship: 36ffc2a2-1a82-4cca-a27b-b7424cbe0d13
			defaultHierarchy: LocalDateTable_7ffbc55c-15ee-4e55-be0d-06baab7feb37.'Hierarquia de datas'

		annotation UnderlyingDateTimeDataType = Date

	column Ano
		dataType: int64
		formatString: 0
		lineageTag: 5a8c26b3-bb22-4d71-be05-8313e03896ad
		summarizeBy: sum
		sourceColumn: Ano

		annotation SummarizationSetBy = Automatic

	column MesNum
		dataType: int64
		formatString: 0
		lineageTag: 1377a2fb-7512-492c-9c25-f0abf002c804
		summarizeBy: sum
		sourceColumn: MesNum

		annotation SummarizationSetBy = Automatic

	column Mes
		dataType: string
		lineageTag: 0a603cca-fece-45cb-865f-6e4a7254e497
		summarizeBy: none
		sourceColumn: Mes
		sortByColumn: AnoMes

	column AnoMes
		dataType: int64
		formatString: 0
		lineageTag: a0b9b676-60a0-42dc-953b-630f28947f9e
		summarizeBy: sum
		sourceColumn: AnoMes

		annotation SummarizationSetBy = Automatic

	column SemanaAno
		dataType: int64
		formatString: 0
		lineageTag: 199e0534-6780-4f99-a3b0-2e42db61c6a6
		summarizeBy: sum
		sourceColumn: SemanaAno

		annotation SummarizationSetBy = Automatic

	column Semana
		dataType: string
		lineageTag: 93423e58-893e-4f75-861b-ffb53716885d
		summarizeBy: none
		sourceColumn: Semana
		sortByColumn: SemanaAno

	partition Calendario = m
		mode: import
		source =
				let
					Fato = vendas,
					DataInicial = Date.From(List.Min(Fato[data])),
					DataFinal = Date.From(List.Max(Fato[data])),
					Datas = List.Dates(DataInicial, Duration.Days(DataFinal - DataInicial) + 1, #duration(1, 0, 0, 0)),
					Tabela = Table.FromList(Datas, Splitter.SplitByNothing(), {"Date"}),
					Tipos = Table.TransformColumnTypes(Tabela, {{"Date", type date}}),
					Ano = Table.AddColumn(Tipos, "Ano", each Date.Year([Date]), Int64.Type),
					MesNum = Table.AddColumn(Ano, "MesNum", each Date.Month([Date]), Int64.Type),
					Mes = Table.AddColumn(MesNum, "Mes", each Date.ToText([Date], "MMM/yy", "pt-BR"), type text),
					AnoMes = Table.AddColumn(Mes, "AnoMes", each Date.Year([Date]) * 100 + Date.Month([Date]), Int64.Type),
					SemanaAno = Table.AddColumn(AnoMes, "SemanaAno", each Date.Year([Date]) * 100 + Date.WeekOfYear([Date], Day.Monday), Int64.Type),
					Semana = Table.AddColumn(SemanaAno, "Semana", each Date.ToText([Date], "yyyy", "pt-BR") & "-S" & Text.PadStart(Text.From(Date.WeekOfYear([Date], Day.Monday)), 2, "0"), type text)
				in
					Semana
